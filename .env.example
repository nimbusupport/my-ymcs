# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
ADMIN_EMAIL=support@example.com

# Worker site lock rules
# Format: email|siteId|siteDisplayName,email|siteId|siteDisplayName
USER_SITE_SCOPES=worker@example.com|your_site_id|Worker_Site

# Search-only YMCS accounts
# Format: id|label|baseUrl|accessKeyId|accessKeySecret,id|label|baseUrl|accessKeyId|accessKeySecret
YMCS_SEARCH_SERVERS=eu-primary|EU Primary|https://eu-api.ymcs.yealink.com|your_access_key_id|your_access_key_secret

# Primary YMCS account for provisioning actions
YMCS_BASE_URL=eu-api.ymcs.yealink.com
YMCS_API_PATH=api/open/v1/manager/region/add
YMCS_ACCESS_KEY_ID=your_access_key_id
YMCS_ACCESS_KEY_SECRET=your_access_key_secret

# Optional YMCS defaults
YMCS_PARENT_ID=your_parent_id
YMCS_SITE_NAME=Your Site
YMCS_SITE_DESC=Created via API
YMCS_CHECK_TARGET=models
YMCS_DEVICE_NAME=ExampleDevice
YMCS_DEVICE_MAC=001122334455
YMCS_DEVICE_SN=EXAMPLE123456
YMCS_DEVICE_MODEL_ID=your_model_id
